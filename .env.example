# Host & Architecture
MAINHOST=127.0.0.1
CHIP=AMD64
# For Apple Silicon (M1/M2/M3) Mac: set CHIP=ARM64 AND
# set MAADSBML_IMAGE=maadsdocker/maads-batch-automl-otics-arm64

# MAADSBML Container Image
# AMD64 (Windows/Linux):
MAADSBML_IMAGE=maadsdocker/maads-batch-automl-otics
# ARM64 (Mac M-series): uncomment the line below and comment out the line above
# MAADSBML_IMAGE=maadsdocker/maads-batch-automl-otics-arm64

# MAADSBML Ports
MAADSBML_TRAININGPORT=5595
MAADSBML_PREDICTIONPORT=5495
MAADSBML_ABORTPORT=10000
MAADSBML_COMPANYNAME=ARIMLABS
# Max minutes MAADSBML will run AutoML training (20 is recommended default)
MAADSBML_MAXRUNTIME=20

# TML / TSS Ports
# Airflow UI → http://localhost:9000
AIRFLOWPORT=9000
# Viperviz dashboard → http://localhost:9005
VIPERVIZPORT=9005
# -1 = no external port (change if you need Shopify to reach the webhook server)
EXTERNALPORT=-1

# Kafka
# Local Kafka inside TSS container
KAFKABROKER=127.0.0.1:9092
# Cloud Kafka
KAFKACLOUDUSERNAME=
KAFKACLOUDPASSWORD=
MAINHOST=127.0.0.1

# GitHub (required by TSS for solution repo commit & ReadTheDocs)
GITREPOURL=
GITUSERNAME=
GITPASSWORD=

# Docker Hub
DOCKERUSERNAME=
DOCKERPASSWORD=

# ReadTheDocs (TSS auto-generates solution docs if provided)
READTHEDOCS=

# Shopify Webhook Secret
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_RAW_TOPIC=shopify-orders-raw
SHOPIFY_WEBHOOK_PORT=8000

# MQTT
MQTTUSERNAME=
MQTTPASSWORD=

# Aggregator-specific settings
# Topics
TML_PRED_TOPIC=shopify-fraud-predictions
TML_PREPROCESS_TOPIC=shopify-fraud-preprocess
FINAL_SCORE_TOPIC=shopify-fraud-scores

# Consumer group
AGG_GROUP_ID=bml-score-aggregator

# MAADSBML (prediction port)
MAADSBML_HOST=127.0.0.1
MAADSBML_PREDICTIONPORT=5495
MAADSBML_MODELTYPE=rf
MAADSBML_PREDTYPE=fraud

# Weights (must sum to anything > 0; code normalizes)
W_TML=0.35
W_RULES=0.25
W_BML=0.40

# Risk tiers
TIER_BLOCK=0.85
TIER_HIGH=0.70
TIER_MEDIUM=0.50

# Rule thresholds
HIGH_VALUE_THRESHOLD=500
HIGH_QTY_THRESHOLD=5
RISKY_GATEWAYS=manual,bank_deposit,crypto

# Velocity rule
IP_VELOCITY_WINDOW_SEC=300
IP_VELOCITY_MAX_HITS=3

# MAADSBML reachability check interval
MAADSBML_RECHECK_SECONDS=60
